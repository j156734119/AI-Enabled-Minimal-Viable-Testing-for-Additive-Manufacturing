# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables
.env

# PyCharm
.idea/
*.iml

# VS Code
.vscode/

# Build / packaging
build/
dist/
*.egg-info/
.eggs/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# Project data
# Keep raw/interim data out of GitHub unless it is a small public example.
data/raw/*
data/interim/*

# Keep folder structure
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
data/processed/*.csv
data/processed/*backup*.csv

# Outputs
outputs/models/*
outputs/figures/*
outputs/tables/*
outputs/reports/*
outputs/*_extracted.txt

!outputs/models/.gitkeep
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep
!outputs/reports/.gitkeep

# Large or copyrighted files
*.pdf
*.zip
*.xlsx
*.xls
*.mat
*.pkl
*.joblib

# Logs
*.log

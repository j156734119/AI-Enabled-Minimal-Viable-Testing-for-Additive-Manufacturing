# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables
.env

# PyCharm
.idea/
*.iml

# VS Code
.vscode/

# Build / packaging
build/
dist/
*.egg-info/
.eggs/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# Project data
# Keep raw/interim data out of GitHub unless it is a small public example.
data/raw/*
data/interim/*

# Keep folder structure
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
data/processed/*.csv
data/processed/*backup*.csv

# Keep the compressed main modelling dataset as a reproducible project artifact.
!data/processed/master_modelling_dataset.csv.gz

# Outputs
outputs/models/*
outputs/figures/*
outputs/tables/*
outputs/reports/*
outputs/*_extracted.txt
outputs/experiments/*

!outputs/experiments/.gitkeep

!outputs/models/.gitkeep
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep
!outputs/reports/.gitkeep

# Large, copyrighted, or generated document/media files
*.doc
*.docx
*.pdf
*.png
*.jpg
*.jpeg
*.zip
*.xlsx
*.xls
*.mat
*.pkl
*.joblib

# Logs
*.log

# Local archives of historical data, models, and results
archive/

# Local Git hooks are installed per clone.
.githooks/

# Local Codex drafts and generated working documents
/.codex/
/.codex_*/
/tmp/

# Meeting and progress-document production artifacts
/outputs/qa_meeting_*/
/outputs/qa_progress_update_*/
/outputs/meeting_one_style.json
/scripts/build_meeting_*.py
/scripts/build_project_progress_update.py
/scripts/build_three_line_progress_update.py
